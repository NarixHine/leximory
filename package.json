{
    "name": "ink",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.8.1",
    "scripts": {
        "check-types": "turbo check-types",
        "dev": "turbo dev --concurrency=15",
        "ios:tunnel": "cloudflared tunnel --protocol http2 run --token \"$LEXIMORY_CLOUDFLARE_TUNNEL_TOKEN\"",
        "format": "prettier --write",
        "format:check": "prettier --check"
    },
    "devDependencies": {
        "prettier": "3.6.2",
        "turbo": "^2.7.3"
    }
}
